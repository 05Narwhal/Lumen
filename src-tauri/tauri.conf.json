{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "26.2.0-alpha",
  "identifier": "com.jlstudios.lumen",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn run licenses && yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumen",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzMUM5MUVBREJCNERCOEQKUldTTjI3VGI2cEVjRTNROHRVdk5OMTJkTXRNTlRhQ0NNU3N0dDdlVEdZZWlqS3p1QlZYUGpTQ0sK",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "JL Studios",
    "copyright": "Copyright (C) 2026 Julian (JL Studios) and the Lumen contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/raw/*": "raw/"
    },
    "fileAssociations": [
      {
        "ext": ["lumenplugin"],
        "name": "Lumen plugin",
        "mimeType": "application/x-lumen-plugin",
        "role": "Viewer"
      }
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "wix": {
        "version": "26.2.0"
      }
    }
  }
}

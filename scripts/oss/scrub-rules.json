{
  "deny": [
    "[A-Za-z]:[\\\\/]+Users[\\\\/]+[^\\\\/\\s\"'`]+",
    "/home/[^/\\s]+/",
    "/Users/[^/\\s]+/",
    "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}",
    "\\bfather|\\bdad\\b"
  ],
  "allow": [
    "^noreply@anthropic\\.com$",
    "@users\\.noreply\\.github\\.com$",
    "@example\\.(?:com|org)$",
    "@[0-9]+x\\.[a-z]+$",
    "[\\\\/]+(?:Users|home)[\\\\/]+(?:a|x|u|j|sample|me|you|ana|user|someone|<you>|100%)[\\\\/]*$"
  ],
  "words": {
    "pro-cloud": ["Lumen Pro", "Lumen Cloud", "one-time purchase", "subscription-based"]
  },
  "skipText": [
    "scripts/oss/scrub-rules.json",
    "src/assets/licenses/notices.json",
    "src-tauri/crates/photos-ml/tests/fixtures/clip-tokenizer.json"
  ],
  "mediaAllow": [
    "src/assets/**",
    "src-tauri/icons/**",
    "installer/src-tauri/icons/**",
    "src-tauri/resources/**",
    "**/fixtures/**",
    "plugins/examples/**/assets/**"
  ]
}
